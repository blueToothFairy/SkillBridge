generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  SME
  ADMIN
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  studentProfile StudentProfile?
  smeProfile     SmeProfile?

  @@map("users")
}

model StudentProfile {
  id           String                   @id @default(uuid())
  userId       String                   @unique
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  university   String
  major        String
  year         Int
  skills       Json
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  applications Application[]
  portfolio    VerifiedPortfolioEntry[]
  certificates Certificate[]

  @@map("student_profiles")
}

model SmeProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  taxCode     String?
  industry    String?
  website     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]

  @@map("sme_profiles")
}

enum TagType {
  CATEGORY
  SKILL
}

enum ProjectStatus {
  DRAFT
  UNDER_REVIEW
  OPEN
  MATCHED
  IN_PROGRESS
  PENDING_ACCEPTANCE
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REVISION_REQUIRED
}

/// Simulated escrow lifecycle: PENDING → HELD → RELEASED.
/// NONE is kept temporarily for DB migration from older schema.
enum EscrowStatus {
  NONE
  PENDING
  HELD
  RELEASED
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  type      TagType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  categorizedProjects Project[] @relation("ProjectCategoryTag")

  @@map("tags")
}

model Project {
  id                String               @id @default(uuid())
  smeId             String
  sme               SmeProfile           @relation(fields: [smeId], references: [id], onDelete: Cascade)
  title             String
  description       String               @db.Text
  categoryTagId     String
  categoryTag       Tag                  @relation("ProjectCategoryTag", fields: [categoryTagId], references: [id])
  requiredSkillTags Json
  budget            Decimal              @db.Decimal(12, 2)
  durationWeeks     Int
  maxApplicants     Int                  @default(5)
  deadline          DateTime
  status            ProjectStatus        @default(OPEN)
  escrowStatus      EscrowStatus         @default(PENDING)
  acceptedAt        DateTime?
  isAutoAccepted    Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  milestones        Milestone[]
  applications      Application[]
  portfolioEntries  VerifiedPortfolioEntry[]
  certificates      Certificate[]
  acceptanceReminders AcceptanceReminder[]

  @@map("projects")
}

model Milestone {
  id               String          @id @default(uuid())
  projectId        String          @map("project_id")
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String          @db.Text
  deadline         DateTime
  orderIndex       Int             @map("order_index")
  status           MilestoneStatus @default(PENDING)
  deliverableUrl   String?         @map("deliverable_url")
  revisionFeedback String?         @db.Text @map("revision_feedback")
  amountVnd        Decimal         @db.Decimal(12, 2) @map("amount_vnd")
  submittedAt      DateTime?       @map("submitted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("milestones")
}

model Application {
  id           String            @id @default(uuid())
  projectId    String            @map("project_id")
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId    String            @map("student_id")
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coverMessage String?           @db.Text @map("cover_message")
  status       ApplicationStatus @default(APPLIED)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([projectId, studentId])
  @@map("applications")
}

/// Stub for Day 28 (Thịnh) — Verified Portfolio after project acceptance.
model VerifiedPortfolioEntry {
  id             String         @id @default(uuid())
  studentId      String         @map("student_id")
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectId      String         @map("project_id")
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTitle   String         @map("project_title")
  smeName        String         @map("sme_name")
  studentRole    String         @default("Contributor") @map("student_role")
  durationWeeks  Int            @map("duration_weeks")
  skillsApplied  Json           @map("skills_applied")
  deliverableUrl String?        @map("deliverable_url")
  completedAt    DateTime       @default(now()) @map("completed_at")
  isVerified     Boolean        @default(true) @map("is_verified")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([studentId, projectId])
  @@map("verified_portfolio_entries")
}

/// Stub for Day 28 (Hà) — Digital certificates.
model Certificate {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectId        String         @map("project_id")
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentName      String         @map("student_name")
  projectTitle     String         @map("project_title")
  smeName          String         @map("sme_name")
  issuedAt         DateTime       @default(now()) @map("issued_at")
  verificationCode String         @unique @map("verification_code")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([studentId, projectId])
  @@map("certificates")
}

/// Stub for Day 27 (Thịnh) — Auto-acceptance reminders.
model AcceptanceReminder {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reminderNumber Int       @map("reminder_number")
  scheduledAt    DateTime  @map("scheduled_at")
  triggeredAt    DateTime? @map("triggered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("acceptance_reminders")
}
