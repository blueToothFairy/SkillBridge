generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  SME
  ADMIN
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  studentProfile StudentProfile?
  smeProfile     SmeProfile?

  @@map("users")
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  university  String
  major       String
  year        Int
  skills      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_profiles")
}

model SmeProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  taxCode     String?
  industry    String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sme_profiles")
}
